generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  role          String
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  casosGestor   CasoOncologico[] @relation("CasoGestor")
  hitos         HitoCaso[]       @relation("HitoActor")
  notas         NotaCaso[]       @relation("NotaAutor")
  notificaciones Notificacion[]
  recetasComoMedico      RecetaQuimio[]   @relation("RecetaMedico")
  recetasComoFarmaceutico RecetaQuimio[]  @relation("RecetaFarmaceutico")
  ciclosPreparados        CicloQuimio[]   @relation("CicloPreparadoPor")
  ciclosAdministrados     CicloQuimio[]   @relation("CicloAdministradoPor")
  historialCiclos         HistorialCiclo[] @relation("HistorialCicloActor")
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Paciente {
  id              String   @id @default(cuid())
  rut             String   @unique
  nombre          String
  fechaNacimiento DateTime?
  sexo            String?
  telefono        String?
  origenOvalle    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  casos           CasoOncologico[]
  recetasQuimio   RecetaQuimio[]
}

// Un mismo paciente puede tener varios casos activos en paralelo (ej. dos patologías
// oncológicas distintas al mismo tiempo) — no se asume un único caso activo por paciente.
model CasoOncologico {
  id                String    @id @default(cuid())
  pacienteId        String
  patologiaSospecha String
  origenIngreso     String?
  fase              String    @default("sospecha")
  hito              String    @default("ingreso_ic_ges")
  estado            String    @default("activo")
  motivoCierre      String?
  fechaCierre       DateTime?
  gestorUserId      String?
  viaTratamiento    String?
  // Marcador manual (GES/LRS/DAC/ninguno) mientras no existe integración real con el sistema que
  // identifica el financiamiento del caso ANTES de llegar a oncología. No se deriva de nada acá.
  financiamiento    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  paciente       Paciente             @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  gestor         User?                @relation("CasoGestor", fields: [gestorUserId], references: [id], onDelete: SetNull)
  hitos          HitoCaso[]
  plazos         PlazoGes[]
  comites        ComitePresentacion[]
  derivaciones   Derivacion[]
  notas          NotaCaso[]
  notificaciones Notificacion[]

  @@index([fase, estado])
  @@index([gestorUserId])
}

model HitoCaso {
  id          String   @id @default(cuid())
  casoId      String
  fase        String
  hito        String
  fecha       DateTime @default(now())
  actorUserId String?
  comentario  String?
  createdAt   DateTime @default(now())

  caso  CasoOncologico @relation(fields: [casoId], references: [id], onDelete: Cascade)
  actor User?          @relation("HitoActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([casoId, createdAt])
}

// Notas de texto libre de cualquier actor (gestor oncológico, enfermera de policlínico,
// admisión, admin) sobre el caso — a diferencia de HitoCaso, no avanza fase/hito ni abre/cierra
// plazos: es solo un registro de observaciones/coordinación entre los distintos roles que
// participan del caso.
model NotaCaso {
  id          String   @id @default(cuid())
  casoId      String
  autorUserId String?
  texto       String
  createdAt   DateTime @default(now())

  caso  CasoOncologico @relation(fields: [casoId], references: [id], onDelete: Cascade)
  autor User?          @relation("NotaAutor", fields: [autorUserId], references: [id], onDelete: SetNull)

  @@index([casoId, createdAt])
}

// Un plazo GES por tipo (confirmacion_diagnostica | etapificacion | inicio_tratamiento |
// seguimiento) por caso. fechaLimite = fechaInicio + diasPlazo (diasPlazo copiado desde
// PlazoConfig al momento de crear el plazo, para no cambiar retroactivamente casos ya en curso
// si el admin ajusta el default después).
model PlazoGes {
  id                String    @id @default(cuid())
  casoId            String
  tipo              String
  fechaInicio       DateTime
  diasPlazo         Int
  fechaLimite       DateTime
  fechaCumplimiento DateTime?
  estado            String    @default("pendiente")
  alerta15dEnviada  Boolean   @default(false)
  alerta5dEnviada   Boolean   @default(false)
  alerta0dEnviada   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  caso CasoOncologico @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([casoId])
  @@index([estado, fechaLimite])
}

// Días por defecto por tipo de plazo GES, editables por admin. Los valores seed son
// referenciales ("ajustar según normativa vigente de la patología"), no un dato legal real.
model PlazoConfig {
  tipo             String @id
  label            String
  diasPlazoDefault Int
  updatedAt        DateTime @updatedAt
}

model ComitePresentacion {
  id            String   @id @default(cuid())
  casoId        String
  fecha         DateTime
  decision      String?
  observaciones String?
  createdAt     DateTime @default(now())

  caso CasoOncologico @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([casoId])
}

model Derivacion {
  id            String   @id @default(cuid())
  casoId        String
  tipo          String
  destino       String?
  fecha         DateTime @default(now())
  estado        String   @default("pendiente")
  observaciones String?
  createdAt     DateTime @default(now())

  caso CasoOncologico @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([casoId])
}

model Notificacion {
  id              String   @id @default(cuid())
  casoId          String?
  cicloQuimioId   String?
  destinationRole String?
  userId          String?
  text            String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  caso CasoOncologico? @relation(fields: [casoId], references: [id], onDelete: Cascade)
  ciclo CicloQuimio?   @relation(fields: [cicloQuimioId], references: [id], onDelete: Cascade)
  user User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationRole, read])
  @@index([userId, read])
}

// ------------------------------------------------------------------
// Módulo de Quimioterapia: receta -> validación/preparación farmacia ->
// agenda de sillón -> administración -> estadística. Independiente de
// CasoOncologico (comparte solo Paciente).
// ------------------------------------------------------------------

// Catálogo real de esquemas (importado de la base de trabajo en Excel de la usuaria — ver
// prisma/data/esquemas.json). Cada línea es un fármaco del esquema con su propio patrón de
// días (nSesion), ciclos y horas de sillón.
model EsquemaQuimio {
  id     String  @id @default(cuid())
  nombre String  @unique
  activo Boolean @default(true)

  lineas  EsquemaFarmacoLinea[]
  recetas RecetaQuimio[]
}

model EsquemaFarmacoLinea {
  id                String @id @default(cuid())
  esquemaId         String
  droga             String
  // "D1" | "D1,D8,D15" | "D2-D16" tal cual viene del Excel — por ahora es solo texto de
  // referencia para la enfermera, no se usa para auto-generar fechas (ver plan).
  nSesion           String
  // Texto, no Int: casi siempre un número ("4", "18"), pero algunos tratamientos de
  // mantención (trastuzumab, zometa, decapeptyl, sandostatin) vienen como "PERMANENTE" en el
  // Excel real — se guarda tal cual.
  nCicloCalculado   String
  freqEntreSesiones Int
  freqEntreCiclos   Int
  horasSillon       Float
  orden             Int    @default(0)

  esquema EsquemaQuimio @relation(fields: [esquemaId], references: [id], onDelete: Cascade)

  @@index([esquemaId])
}

// Calendario real (2027 importado del Excel — prisma/data/calendario_2027.json). Fuera de ese
// rango de fechas, resolverConfigDia() en server/lib/quimio.js usa un fallback genérico que
// replica la regla general del Excel (lunes-jueves 08:15-16:45, viernes 08:15-15:45, 17 de
// septiembre y 24 de diciembre 08:15-11:45 todos los años, fin de semana no hábil).
model DiaHabilQuimio {
  fecha      DateTime @id
  habil      Boolean
  feriado    Boolean  @default(false)
  horaInicio String?
  horaFin    String?
}

model Sillon {
  id        String   @id @default(cuid())
  nombre    String   @unique
  // Orden de despliegue (Sillón 1..16) — nombre es texto, así que ordenar por nombre da
  // "Sillón 1, Sillón 10, Sillón 11..., Sillón 2" alfabético; orden guarda el número real.
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  ciclos CicloQuimio[]
}

// borrador -> validada (farmacia) | rechazada (farmacia, con motivo) -> anulada (oncólogo/admin).
// Solo una receta validada puede tener CicloQuimio agendados (se valida en el endpoint, no acá).
model RecetaQuimio {
  id                      String    @id @default(cuid())
  pacienteId              String
  medicoUserId            String?
  esquemaId               String?
  // Código GES del diagnóstico que motiva esta receta (ej. "Cáncer de mama"). Opcional — no
  // bloquea el flujo de prescripción; su valor se usa para reportar/agrupar en Estadísticas una
  // vez el ciclo queda administrado.
  codigoGesId             String?
  protocolo               String
  indicacion              String?
  diagnostico             String?
  intencion               String?
  riesgoEmetico           String?
  numeroCiclosTotal       Int
  intervaloDias           Int
  pesoKg                  Float?
  tallaCm                 Float?
  superficieCorporal      Float?
  otrasIndicaciones       String?
  neupogenIndicado        Boolean   @default(false)
  neupogenDias            String?
  estado                  String    @default("borrador")
  farmaciaUserId          String?
  fechaValidacion         DateTime?
  observacionesValidacion String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  paciente     Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medico       User?          @relation("RecetaMedico", fields: [medicoUserId], references: [id], onDelete: SetNull)
  farmaceutico User?          @relation("RecetaFarmaceutico", fields: [farmaciaUserId], references: [id], onDelete: SetNull)
  esquema      EsquemaQuimio? @relation(fields: [esquemaId], references: [id], onDelete: SetNull)
  codigoGes    CodigoGes?     @relation(fields: [codigoGesId], references: [id], onDelete: SetNull)
  farmacos     DetalleRecetaFarmaco[]
  ciclos       CicloQuimio[]

  @@index([pacienteId])
  @@index([estado])
}

// Catálogo de códigos GES (Garantías Explícitas en Salud) — vacío hasta que se importe el
// listado oficial real; mientras tanto, "codigo" se puede usar también para un identificador
// interno provisorio si hace falta.
model CodigoGes {
  id      String  @id @default(cuid())
  codigo  String  @unique
  nombre  String
  activo  Boolean @default(true)

  recetas RecetaQuimio[]
}

// categoria: premedicacion (ej. Dexametasona 12h antes) | quimioterapia (las drogas citotóxicas
// propiamente tal) | rescate (indicaciones PRN post-sesión, ej. "Ondansetron si hay vómitos").
model DetalleRecetaFarmaco {
  id                  String @id @default(cuid())
  recetaId            String
  categoria           String @default("quimioterapia")
  farmaco             String
  dosis               String
  unidad              String
  via                 String
  frecuencia          String?
  // Copiado de EsquemaFarmacoLinea.nSesion al elegir un esquema del catálogo — "D1,D8,D15",
  // etc. Texto de referencia, no se usa para calcular fechas automáticamente.
  nSesion             String?
  // Solo aplica a categoria="quimioterapia": "LRS" | "DAC" — clasificación de compra/financiamiento
  // del fármaco citotóxico.
  clasificacion       String?
  duracionInfusionMin Int?
  orden               Int    @default(0)

  receta RecetaQuimio @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@index([recetaId])
}

// Una fila = un ciclo del protocolo agendado en una fecha real (a diferencia de
// PabellonAllocation en agendas-repo, que es una plantilla semanal sin fechas). Estado:
// programado -> en_preparacion -> listo_para_administrar -> en_administracion -> administrado,
// con suspendido/cancelado como salida desde cualquier estado no terminal.
model CicloQuimio {
  id                    String    @id @default(cuid())
  recetaId              String
  numeroCiclo           Int
  fechaProgramada       DateTime
  // "HH:MM" — horario exacto, no turno (coincide con cómo la usuaria agenda sillones en su
  // planilla real: bloques de 30 min dentro del horario hábil del día).
  horaInicio            String
  horaTermino           String
  sillonId              String?
  duracionEstimadaMin   Int       @default(180)
  estado                String    @default("programado")
  preparadoPorUserId    String?
  fechaPreparacion      DateTime?
  administradoPorUserId String?
  fechaInicioReal       DateTime?
  fechaTerminoReal      DateTime?
  reaccionAdversa       Boolean   @default(false)
  observaciones         String?
  motivoSuspension      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  receta          RecetaQuimio     @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  sillon          Sillon?          @relation(fields: [sillonId], references: [id], onDelete: SetNull)
  preparadoPor    User?            @relation("CicloPreparadoPor", fields: [preparadoPorUserId], references: [id], onDelete: SetNull)
  administradoPor User?            @relation("CicloAdministradoPor", fields: [administradoPorUserId], references: [id], onDelete: SetNull)
  historial       HistorialCiclo[]
  notificaciones  Notificacion[]

  @@index([fechaProgramada, sillonId])
  @@index([estado])
  @@index([recetaId])
}

model HistorialCiclo {
  id          String   @id @default(cuid())
  cicloId     String
  estado      String
  fecha       DateTime @default(now())
  actorUserId String?
  comentario  String?

  ciclo CicloQuimio @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  actor User?       @relation("HistorialCicloActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([cicloId, fecha])
}
